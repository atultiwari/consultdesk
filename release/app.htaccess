# This folder holds ConsultDesk's code, settings and uploads. It must never be served to visitors;
# keep it outside the web folder. This file is only a safety net if it ends up inside one.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
