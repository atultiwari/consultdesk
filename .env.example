# LOCAL DEV ONLY — copy to .env for docker compose. These are throwaway placeholders.
DB_ROOT_PASSWORD=dev-root-change-me
DB_NAME=consultdesk
# Keep DB_USER as-is: docker/mariadb/init.sql grants the test DB to this user.
DB_USER=consultdesk
DB_PASSWORD=dev-password-change-me
API_PORT=8080
DB_PORT=3307
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Overrides for the API container (defaults live in docker-compose.yml).
# APP_URL=http://localhost:5173
# APP_KEY is required and has no default. Generate one (do not commit it):
#   php -r 'echo "APP_KEY=base64:".base64_encode(random_bytes(32)).PHP_EOL;' >> .env
# CRON_KEY=<at least 32 characters>

# Optional, local only: lets the E2E test confirm a booking through the Telegram webhook.
# TELEGRAM_BOT_TOKEN=123456789:<35 letters or digits>
# TELEGRAM_WEBHOOK_SECRET=<32+ random characters>

# Optional: default Razorpay TEST keys, so they survive a database reset. Keys saved on the admin
# Payments page take precedence; removing those falls back to these.
# RAZORPAY_KEY_ID=rzp_test_<from Razorpay → Settings → API Keys>
# RAZORPAY_KEY_SECRET=<key secret>
# RAZORPAY_WEBHOOK_SECRET=<the secret you typed into the Razorpay webhook, 16+ characters>

# Optional: the first owner. With a password, `php bin/install.php` (or the first visit to the
# admin path) creates this owner on an empty database. Without one, the first-run form is filled
# in and asks only for a password. Remove OWNER_PASSWORD once you've signed in on a real site.
# OWNER_EMAIL=you@example.com
# OWNER_NAME=Your Name
# OWNER_PASSWORD=<10+ characters>
# Optional: also require this key on the first-run form (for a public server).
# SETUP_KEY=<16+ random characters>
